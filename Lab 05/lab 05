# Question 7
url = "https://api.agify.io"
names = ["ahmed", "sara", "ali", "fatima", "hassan", "ayesha", "bilal", "zainab"]
params = {"name[]": names}

try:
    response = requests.get(url, params=params, timeout=5)
    print("\nStatus Code:", response.status_code)
    response.raise_for_status()
    data = response.json()

    results = []
    for item in data:
        if item["age"] is not None:
            results.append({"name": item["name"], "age": item["age"], "count": item["count"]})

    total_age = 0
    categories = {"Below 30": 0, "30 to 49": 0, "50 and above": 0}

    for result in results:
        total_age += result["age"]
        if result["age"] < 30:
            categories["Below 30"] += 1
        elif result["age"] < 50:
            categories["30 to 49"] += 1
        else:
            categories["50 and above"] += 1

    average_age = total_age / len(results)

    highest_result = results[0]
    for result in results:
        if result["count"] > highest_result["count"]:
            highest_result = result

    with open("api_results.json", "w", encoding="utf-8") as file:
        json.dump(results, file, indent=4)

    with open("api_results.csv", "w", newline="", encoding="utf-8") as file:
        writer = csv.DictWriter(file, fieldnames=["name", "age", "count"])
        writer.writeheader()
        writer.writerows(results)

    with open("api_results.json", "r", encoding="utf-8") as file:
        saved_json = json.load(file)

    with open("api_results.csv", "r", newline="", encoding="utf-8") as file:
        reader = csv.DictReader(file)
        saved_csv = list(reader)
except requests.exceptions.Timeout:
    print("Request timed out.")
except requests.exceptions.ConnectionError:
    print("Connection error.")
except requests.exceptions.HTTPError as error:
    print("HTTP error occurred:", error)
except FileNotFoundError:
    print("File not found.")
except ValueError:
    print("Invalid JSON data.")
except (KeyError, TypeError):
    print("Unexpected response format from the API.")
except ZeroDivisionError:
    print("The API did not return any valid predictions.")
except requests.exceptions.RequestException as error:
    print("Request failed:", error)
except OSError as error:
    print("File error:", error)
else:
    print("\nPredictions received:")
    for result in results:
        print(result)
    print("\nAverage Predicted Age:", round(average_age, 2))
    print("Age Categories:", categories)
    print("Highest Sample Count:", highest_result["name"], "-", highest_result["count"])

    result_names = [result["name"] for result in results]
    json_names = [item["name"] for item in saved_json]
    csv_names = [row["name"] for row in saved_csv]

    print("\nRecords in api_results.json:", len(saved_json))
    print("Records in api_results.csv:", len(saved_csv))
    print("JSON file verified:", json_names == result_names)
    print("CSV file verified:", csv_names == result_names)
finally:
    print("\nProgram finished.")