# Question 5
url = "https://jsonplaceholder.typicode.com/comments"
post_id = input("\nEnter a post ID (1-100) to fetch comments: ")
params = {"postId": post_id}

try:
    response = requests.get(url, params=params, timeout=5)
    response.raise_for_status()
    data = response.json()
    if not isinstance(data, list) or len(data) == 0:
        print("No text data found for this query.")
    else:
        texts = []
        for item in data:
            text_record = {
                "id": item["id"],
                "post_id": item["postId"],
                "author": item["email"],
                "title": item["name"],
                "text": item["body"]
            }
            texts.append(text_record)
            print("\nID:", text_record["id"])
            print("Author:", text_record["author"])
            print("Title:", text_record["title"])
            print("Text:", text_record["text"])
        with open("texts.json", "w", encoding="utf-8") as file:
            json.dump(texts, file, indent=4)
        with open("texts.csv", "w", newline="", encoding="utf-8") as file:
            writer = csv.DictWriter(file, fieldnames=["id", "post_id", "author", "title", "text"])
            writer.writeheader()
            writer.writerows(texts)
        print("\nText data saved to texts.json and texts.csv successfully.")
except requests.exceptions.Timeout:
    print("Request timed out.")
except requests.exceptions.ConnectionError:
    print("Connection error.")
except requests.exceptions.HTTPError as error:
    print("HTTP error occurred:", error)
except ValueError:
    print("Invalid response received from the API.")
except KeyError:
    print("Unexpected response format from the API.")
except requests.exceptions.RequestException as error:
    print("Request failed:", error)
except OSError as error:
    print("File error:", error)

